# Salin file ini menjadi .env lalu isi nilainya. .env JANGAN di-commit.

# --- Google Cloud Vision (OCR) ---
# API key dikirim Protelindo terpisah (lihat Key & Git.md).
GOOGLE_VISION_API_KEY=
# Alternatif service account (kosongkan bila pakai API key di atas):
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/ke/service-account.json

# --- Email: IMAP untuk membaca (mailbox pribadi) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Email: SMTP untuk mengirim (permintaan approval) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Gmail: IMAP_PASSWORD/SMTP_PASSWORD adalah App Password
# (myaccount.google.com -> Security -> App passwords), bukan password login.

# --- Perilaku ---
HEADLESS=false
# Menit menunggu balasan approval dalam satu run (0 = tidak menunggu;
# balasan diproses pada run berikutnya).
APPROVAL_WAIT_MINUTES=0
# true = email tidak benar-benar dikirim, hanya dicetak (untuk pengujian).
MAIL_DRY_RUN=false
